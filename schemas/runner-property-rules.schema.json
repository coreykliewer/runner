{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runner Property Rules 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
  },
  "$defs": {
    "propertyId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}(?![\\s\\S])",
      "not": { "enum": ["__proto__", "prototype", "constructor"] }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "operator", "value"],
      "properties": {
        "property": { "$ref": "#/$defs/propertyId" },
        "operator": { "enum": ["=", "!=", ">", "<", ">=", "<="] },
        "value": { "type": "number" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "property", "value"],
      "properties": {
        "operation": { "enum": ["set", "add", "subtract"] },
        "property": { "$ref": "#/$defs/propertyId" },
        "value": { "type": "number" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["then"],
      "properties": {
        "if": { "$ref": "#/$defs/condition" },
        "then": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      }
    }
  }
}
