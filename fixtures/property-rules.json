{
  "description": "Standalone test definitions only; names never select evaluator behavior.",
  "tiles": {
    "Water": {
      "displayOnly": "An unrelated field retained by validation",
      "propertyRules": { "version": 1, "blocks": [
        { "then": [{ "operation": "set", "property": "wet", "value": 5 }] }
      ] }
    },
    "Air": {
      "propertyRules": { "version": 1, "blocks": [
        { "if": { "property": "wet", "operator": ">", "value": 0 },
          "then": [{ "operation": "subtract", "property": "wet", "value": 1 }] }
      ] }
    },
    "Fire": {
      "propertyRules": { "version": 1, "blocks": [
        { "then": [{ "operation": "set", "property": "burning", "value": 1 }] },
        { "if": { "property": "wet", "operator": ">=", "value": 2 }, "then": [
          { "operation": "subtract", "property": "burning", "value": 1 },
          { "operation": "subtract", "property": "wet", "value": 2 }
        ] }
      ] }
    }
  }
}
